{%- comment -%}
  FAQ Accordion — from shopify-blocks (https://github.com/ambduu/shopify-blocks)
  Accessible <details> accordion + FAQPage structured data for Google rich results.
{%- endcomment -%}
<style>
  .sb-faq-{{ section.id }} {
    --sb-accent: {{ section.settings.accent }};
    padding: {{ section.settings.padding }}px 20px;
    background: {{ section.settings.background }};
    color: {{ section.settings.text_color }};
  }
  .sb-faq-{{ section.id }} .sb-faq__inner { max-width: 760px; margin: 0 auto; }
  .sb-faq-{{ section.id }} .sb-faq__heading { text-align: center; margin: 0 0 8px; font-size: clamp(26px, 4vw, 38px); }
  .sb-faq-{{ section.id }} .sb-faq__sub { text-align: center; opacity: .75; margin: 0 0 32px; }
  .sb-faq-{{ section.id }} details {
    border-bottom: 1px solid color-mix(in srgb, currentColor 15%, transparent);
  }
  .sb-faq-{{ section.id }} summary {
    list-style: none;
    cursor: pointer;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 16px;
    padding: 20px 4px;
    font-weight: 600;
    font-size: 17px;
  }
  .sb-faq-{{ section.id }} summary::-webkit-details-marker { display: none; }
  .sb-faq-{{ section.id }} .sb-faq__icon {
    flex: none;
    width: 28px; height: 28px;
    border-radius: 50%;
    display: grid; place-items: center;
    background: color-mix(in srgb, var(--sb-accent) 14%, transparent);
    color: var(--sb-accent);
    transition: transform .25s ease;
  }
  .sb-faq-{{ section.id }} details[open] .sb-faq__icon { transform: rotate(45deg); }
  .sb-faq-{{ section.id }} .sb-faq__answer { padding: 0 4px 22px; line-height: 1.65; opacity: .85; }
  .sb-faq-{{ section.id }} .sb-faq__answer p:first-child { margin-top: 0; }
  @media (prefers-reduced-motion: reduce) { .sb-faq-{{ section.id }} .sb-faq__icon { transition: none; } }
</style>

<div class="sb-faq-{{ section.id }}">
  <div class="sb-faq__inner">
    {%- if section.settings.heading != blank -%}
      <h2 class="sb-faq__heading">{{ section.settings.heading | escape }}</h2>
    {%- endif -%}
    {%- if section.settings.subheading != blank -%}
      <p class="sb-faq__sub">{{ section.settings.subheading | escape }}</p>
    {%- endif -%}

    {%- for block in section.blocks -%}
      <details {{ block.shopify_attributes }}{% if forloop.first and section.settings.open_first %} open{% endif %}>
        <summary>
          <span>{{ block.settings.question | escape }}</span>
          <span class="sb-faq__icon" aria-hidden="true">
            <svg width="14" height="14" viewBox="0 0 14 14"><path d="M7 1v12M1 7h12" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
          </span>
        </summary>
        <div class="sb-faq__answer">{{ block.settings.answer }}</div>
      </details>
    {%- endfor -%}
  </div>
</div>

{%- if section.settings.enable_schema and section.blocks.size > 0 -%}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {%- for block in section.blocks -%}
    {
      "@type": "Question",
      "name": {{ block.settings.question | json }},
      "acceptedAnswer": { "@type": "Answer", "text": {{ block.settings.answer | json }} }
    }{% unless forloop.last %},{% endunless %}
    {%- endfor -%}
  ]
}
</script>
{%- endif -%}

{% schema %}
{
  "name": "FAQ accordion",
  "tag": "section",
  "class": "sb-section",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Frequently asked questions" },
    { "type": "text", "id": "subheading", "label": "Subheading", "default": "Everything you need to know before you order." },
    { "type": "checkbox", "id": "open_first", "label": "Open first question", "default": true },
    { "type": "checkbox", "id": "enable_schema", "label": "Add FAQ structured data (SEO)", "default": true },
    { "type": "color", "id": "accent", "label": "Accent color", "default": "#ff5a36" },
    { "type": "color", "id": "background", "label": "Background", "default": "#ffffff" },
    { "type": "color", "id": "text_color", "label": "Text color", "default": "#1d1b24" },
    { "type": "range", "id": "padding", "label": "Vertical padding", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 64 }
  ],
  "blocks": [
    {
      "type": "question",
      "name": "Question",
      "settings": [
        { "type": "text", "id": "question", "label": "Question", "default": "How long does shipping take?" },
        { "type": "richtext", "id": "answer", "label": "Answer", "default": "<p>Orders ship within 1–2 business days. Delivery usually takes 3–5 days in Europe and 5–10 days worldwide.</p>" }
      ]
    }
  ],
  "presets": [
    {
      "name": "FAQ accordion",
      "blocks": [
        { "type": "question" },
        { "type": "question", "settings": { "question": "What is your return policy?", "answer": "<p>Not in love? Return any unused item within 30 days for a full refund.</p>" } },
        { "type": "question", "settings": { "question": "Do you ship internationally?", "answer": "<p>Yes — we ship to over 50 countries. Duties are calculated at checkout.</p>" } },
        { "type": "question", "settings": { "question": "How can I contact you?", "answer": "<p>Email us any time and we will reply within 24 hours.</p>" } }
      ]
    }
  ]
}
{% endschema %}
