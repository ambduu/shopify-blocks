{%- comment -%}
  Announcement Marquee — from shopify-blocks (https://github.com/ambduu/shopify-blocks)
  Infinite scrolling announcement bar. Pauses on hover, respects reduced motion.
{%- endcomment -%}
<style>
  .sb-marquee-{{ section.id }} {
    --sb-speed: {{ section.settings.speed }}s;
    background: {{ section.settings.background }};
    color: {{ section.settings.text_color }};
    overflow: hidden;
    font-size: {{ section.settings.font_size }}px;
    font-weight: 600;
    letter-spacing: .02em;
    {% if section.settings.uppercase %}text-transform: uppercase;{% endif %}
  }
  .sb-marquee-{{ section.id }} .sb-marquee__track {
    display: flex;
    width: max-content;
    animation: sb-marquee-{{ section.id }} var(--sb-speed) linear infinite;
    {% if section.settings.direction == 'right' %}animation-direction: reverse;{% endif %}
  }
  .sb-marquee-{{ section.id }}:hover .sb-marquee__track { animation-play-state: paused; }
  .sb-marquee-{{ section.id }} .sb-marquee__group { display: flex; flex: none; }
  .sb-marquee-{{ section.id }} .sb-marquee__item {
    display: inline-flex;
    align-items: center;
    gap: 28px;
    padding: 11px 0 11px 28px;
    white-space: nowrap;
    color: inherit;
    text-decoration: none;
  }
  .sb-marquee-{{ section.id }} .sb-marquee__sep { opacity: .6; }
  @keyframes sb-marquee-{{ section.id }} { to { transform: translateX(-50%); } }
  @media (prefers-reduced-motion: reduce) {
    .sb-marquee-{{ section.id }} .sb-marquee__track { animation: none; }
  }
</style>

<div class="sb-marquee-{{ section.id }}" role="region" aria-label="{{ 'Announcements' }}">
  <div class="sb-marquee__track">
    {%- for copy in (1..2) -%}
      <div class="sb-marquee__group"{% if copy == 2 %} aria-hidden="true"{% endif %}>
        {%- for repeat in (1..3) -%}
          {%- for block in section.blocks -%}
            {%- if block.settings.link != blank -%}
              <a class="sb-marquee__item" href="{{ block.settings.link }}" {{ block.shopify_attributes }}{% if copy == 2 or repeat > 1 %} tabindex="-1"{% endif %}>
            {%- else -%}
              <span class="sb-marquee__item" {{ block.shopify_attributes }}>
            {%- endif -%}
              {{ block.settings.text | escape }}
              <span class="sb-marquee__sep" aria-hidden="true">{{ section.settings.separator | escape }}</span>
            {%- if block.settings.link != blank -%}</a>{%- else -%}</span>{%- endif -%}
          {%- endfor -%}
        {%- endfor -%}
      </div>
    {%- endfor -%}
  </div>
</div>

{% schema %}
{
  "name": "Announcement marquee",
  "tag": "section",
  "class": "sb-section",
  "settings": [
    { "type": "range", "id": "speed", "label": "Loop duration (slower = higher)", "min": 10, "max": 80, "step": 2, "unit": "s", "default": 30 },
    { "type": "select", "id": "direction", "label": "Direction", "default": "left", "options": [ { "value": "left", "label": "Left" }, { "value": "right", "label": "Right" } ] },
    { "type": "text", "id": "separator", "label": "Separator", "default": "✦" },
    { "type": "range", "id": "font_size", "label": "Font size", "min": 11, "max": 28, "step": 1, "unit": "px", "default": 14 },
    { "type": "checkbox", "id": "uppercase", "label": "Uppercase", "default": true },
    { "type": "color", "id": "background", "label": "Background", "default": "#1d1b24" },
    { "type": "color", "id": "text_color", "label": "Text color", "default": "#ffffff" }
  ],
  "blocks": [
    {
      "type": "message",
      "name": "Message",
      "settings": [
        { "type": "text", "id": "text", "label": "Text", "default": "Free shipping on orders over €50" },
        { "type": "url", "id": "link", "label": "Link" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Announcement marquee",
      "blocks": [
        { "type": "message" },
        { "type": "message", "settings": { "text": "30-day easy returns" } },
        { "type": "message", "settings": { "text": "New collection just dropped" } }
      ]
    }
  ]
}
{% endschema %}
