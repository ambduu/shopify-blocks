{%- comment -%}
  Before / After Slider — from shopify-blocks (https://github.com/ambduu/shopify-blocks)
  Drag to compare two images. Keyboard accessible (it's a real range input).
{%- endcomment -%}
<style>
  .sb-ba-{{ section.id }} {
    padding: {{ section.settings.padding }}px 20px;
    background: {{ section.settings.background }};
    color: {{ section.settings.text_color }};
  }
  .sb-ba-{{ section.id }} .sb-ba__inner { max-width: {{ section.settings.max_width }}px; margin: 0 auto; }
  .sb-ba-{{ section.id }} .sb-ba__heading { text-align: center; margin: 0 0 24px; font-size: clamp(24px, 4vw, 36px); }
  .sb-ba-{{ section.id }} .sb-ba__frame {
    --pos: 50%;
    position: relative;
    aspect-ratio: {{ section.settings.ratio }};
    border-radius: {{ section.settings.radius }}px;
    overflow: hidden;
    user-select: none;
    background: #eee;
  }
  .sb-ba-{{ section.id }} .sb-ba__img, .sb-ba-{{ section.id }} .sb-ba__img img,
  .sb-ba-{{ section.id }} .sb-ba__img svg { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  .sb-ba-{{ section.id }} .sb-ba__img--before { clip-path: inset(0 calc(100% - var(--pos)) 0 0); z-index: 1; }
  .sb-ba-{{ section.id }} .sb-ba__label {
    position: absolute; top: 14px; z-index: 2;
    padding: 5px 12px; border-radius: 999px;
    background: rgba(0,0,0,.55); color: #fff; font-size: 13px; font-weight: 600;
  }
  .sb-ba-{{ section.id }} .sb-ba__label--before { left: 14px; }
  .sb-ba-{{ section.id }} .sb-ba__label--after { right: 14px; }
  .sb-ba-{{ section.id }} .sb-ba__handle {
    position: absolute; top: 0; bottom: 0; left: var(--pos); z-index: 3;
    width: 3px; margin-left: -1.5px; background: #fff; pointer-events: none;
    box-shadow: 0 0 12px rgba(0,0,0,.25);
  }
  .sb-ba-{{ section.id }} .sb-ba__handle::after {
    content: '⟷'; position: absolute; top: 50%; left: 50%; transform: translate(-50%, -50%);
    width: 44px; height: 44px; border-radius: 50%; background: #fff; color: #111;
    display: grid; place-items: center; font-size: 20px; box-shadow: 0 4px 14px rgba(0,0,0,.25);
  }
  .sb-ba-{{ section.id }} .sb-ba__range {
    position: absolute; inset: 0; z-index: 4; width: 100%; height: 100%;
    margin: 0; opacity: 0; cursor: ew-resize;
  }
  .sb-ba-{{ section.id }} .sb-ba__range:focus-visible + .sb-ba__handle::after { outline: 3px solid #4c8dff; }
  .sb-ba-{{ section.id }} .sb-ba__caption { text-align: center; opacity: .75; margin-top: 14px; }
</style>

<div class="sb-ba-{{ section.id }}">
  <div class="sb-ba__inner">
    {%- if section.settings.heading != blank -%}
      <h2 class="sb-ba__heading">{{ section.settings.heading | escape }}</h2>
    {%- endif -%}
    <div class="sb-ba__frame" style="--pos: {{ section.settings.start }}%;">
      <div class="sb-ba__img sb-ba__img--after">
        {%- if section.settings.after_image != blank -%}
          {{ section.settings.after_image | image_url: width: 1600 | image_tag: loading: 'lazy', widths: '600, 900, 1200, 1600', sizes: '(min-width: 1000px) 1000px, 100vw', alt: section.settings.after_label }}
        {%- else -%}
          {{ 'lifestyle-2' | placeholder_svg_tag }}
        {%- endif -%}
      </div>
      <div class="sb-ba__img sb-ba__img--before">
        {%- if section.settings.before_image != blank -%}
          {{ section.settings.before_image | image_url: width: 1600 | image_tag: loading: 'lazy', widths: '600, 900, 1200, 1600', sizes: '(min-width: 1000px) 1000px, 100vw', alt: section.settings.before_label }}
        {%- else -%}
          {{ 'lifestyle-1' | placeholder_svg_tag }}
        {%- endif -%}
      </div>
      {%- if section.settings.before_label != blank -%}<span class="sb-ba__label sb-ba__label--before">{{ section.settings.before_label | escape }}</span>{%- endif -%}
      {%- if section.settings.after_label != blank -%}<span class="sb-ba__label sb-ba__label--after">{{ section.settings.after_label | escape }}</span>{%- endif -%}
      <input class="sb-ba__range" type="range" min="0" max="100" value="{{ section.settings.start }}"
        aria-label="Compare before and after" oninput="this.parentNode.style.setProperty('--pos', this.value + '%')">
      <span class="sb-ba__handle" aria-hidden="true"></span>
    </div>
    {%- if section.settings.caption != blank -%}
      <p class="sb-ba__caption">{{ section.settings.caption | escape }}</p>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "Before / after slider",
  "tag": "section",
  "class": "sb-section",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "See the difference" },
    { "type": "image_picker", "id": "before_image", "label": "Before image" },
    { "type": "text", "id": "before_label", "label": "Before label", "default": "Before" },
    { "type": "image_picker", "id": "after_image", "label": "After image" },
    { "type": "text", "id": "after_label", "label": "After label", "default": "After" },
    { "type": "text", "id": "caption", "label": "Caption", "default": "Drag the slider to compare." },
    { "type": "range", "id": "start", "label": "Starting position", "min": 10, "max": 90, "step": 5, "unit": "%", "default": 50 },
    { "type": "select", "id": "ratio", "label": "Aspect ratio", "default": "16 / 10", "options": [
      { "value": "1 / 1", "label": "Square" }, { "value": "4 / 5", "label": "Portrait" },
      { "value": "16 / 10", "label": "Landscape" }, { "value": "21 / 9", "label": "Wide" } ] },
    { "type": "range", "id": "radius", "label": "Corner radius", "min": 0, "max": 40, "step": 2, "unit": "px", "default": 18 },
    { "type": "range", "id": "max_width", "label": "Max width", "min": 500, "max": 1600, "step": 50, "unit": "px", "default": 1000 },
    { "type": "range", "id": "padding", "label": "Vertical padding", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 56 },
    { "type": "color", "id": "background", "label": "Background", "default": "#ffffff" },
    { "type": "color", "id": "text_color", "label": "Text color", "default": "#1d1b24" }
  ],
  "presets": [ { "name": "Before / after slider" } ]
}
{% endschema %}
