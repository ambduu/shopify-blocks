{%- comment -%}
  Testimonial Wall — from shopify-blocks (https://github.com/ambduu/shopify-blocks)
  Masonry-style review cards with star ratings, plus an average rating summary.
{%- endcomment -%}
<style>
  .sb-tw-{{ section.id }} {
    padding: {{ section.settings.padding }}px 20px;
    background: {{ section.settings.background }};
    color: {{ section.settings.text_color }};
  }
  .sb-tw-{{ section.id }} .sb-tw__inner { max-width: 1200px; margin: 0 auto; }
  .sb-tw-{{ section.id }} .sb-tw__head { text-align: center; margin-bottom: 36px; }
  .sb-tw-{{ section.id }} .sb-tw__heading { margin: 0 0 8px; font-size: clamp(26px, 4vw, 38px); }
  .sb-tw-{{ section.id }} .sb-tw__avg { opacity: .8; }
  .sb-tw-{{ section.id }} .sb-tw__stars { color: {{ section.settings.star_color }}; letter-spacing: 2px; }
  .sb-tw-{{ section.id }} .sb-tw__grid { columns: {{ section.settings.columns }} 260px; column-gap: 18px; }
  .sb-tw-{{ section.id }} .sb-tw__card {
    break-inside: avoid;
    margin: 0 0 18px;
    padding: 22px;
    border-radius: 18px;
    background: {{ section.settings.card_bg }};
    box-shadow: 0 1px 2px rgba(0,0,0,.04), 0 8px 24px rgba(0,0,0,.05);
  }
  .sb-tw-{{ section.id }} .sb-tw__quote { margin: 10px 0 16px; line-height: 1.6; font-size: 15.5px; }
  .sb-tw-{{ section.id }} .sb-tw__who { display: flex; align-items: center; gap: 10px; font-size: 14px; }
  .sb-tw-{{ section.id }} .sb-tw__avatar {
    width: 36px; height: 36px; border-radius: 50%; flex: none; overflow: hidden;
    display: grid; place-items: center; font-weight: 700; color: #fff;
    background: {{ section.settings.star_color }};
  }
  .sb-tw-{{ section.id }} .sb-tw__avatar img { width: 100%; height: 100%; object-fit: cover; }
  .sb-tw-{{ section.id }} .sb-tw__name { font-weight: 700; }
  .sb-tw-{{ section.id }} .sb-tw__verified { opacity: .6; font-size: 12.5px; }
</style>

{%- liquid
  assign total = 0
  for block in section.blocks
    assign total = total | plus: block.settings.rating
  endfor
  if section.blocks.size > 0
    assign avg10 = total | times: 10 | divided_by: section.blocks.size
  else
    assign avg10 = 0
  endif
  assign avg_whole = avg10 | divided_by: 10
  assign avg_dec = avg10 | modulo: 10
-%}

<div class="sb-tw-{{ section.id }}">
  <div class="sb-tw__inner">
    <div class="sb-tw__head">
      {%- if section.settings.heading != blank -%}
        <h2 class="sb-tw__heading">{{ section.settings.heading | escape }}</h2>
      {%- endif -%}
      {%- if section.settings.show_average and section.blocks.size > 0 -%}
        <div class="sb-tw__avg"><span class="sb-tw__stars" aria-hidden="true">★★★★★</span>
          {{ avg_whole }}.{{ avg_dec }} / 5 from {{ section.blocks.size }} reviews</div>
      {%- endif -%}
    </div>
    <div class="sb-tw__grid">
      {%- for block in section.blocks -%}
        <figure class="sb-tw__card" {{ block.shopify_attributes }}>
          <div class="sb-tw__stars" role="img" aria-label="{{ block.settings.rating }} out of 5 stars">
            {%- for i in (1..5) -%}{% if i <= block.settings.rating %}★{% else %}☆{% endif %}{%- endfor -%}
          </div>
          <blockquote class="sb-tw__quote">{{ block.settings.quote | escape }}</blockquote>
          <figcaption class="sb-tw__who">
            <span class="sb-tw__avatar">
              {%- if block.settings.avatar != blank -%}
                {{ block.settings.avatar | image_url: width: 80 | image_tag: loading: 'lazy', alt: block.settings.name }}
              {%- else -%}
                {{ block.settings.name | slice: 0 | upcase }}
              {%- endif -%}
            </span>
            <span>
              <span class="sb-tw__name">{{ block.settings.name | escape }}</span><br>
              {%- if block.settings.detail != blank -%}<span class="sb-tw__verified">{{ block.settings.detail | escape }}</span>{%- endif -%}
            </span>
          </figcaption>
        </figure>
      {%- endfor -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Testimonial wall",
  "tag": "section",
  "class": "sb-section",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Loved by customers" },
    { "type": "checkbox", "id": "show_average", "label": "Show average rating", "default": true },
    { "type": "range", "id": "columns", "label": "Max columns", "min": 1, "max": 4, "step": 1, "default": 3 },
    { "type": "color", "id": "star_color", "label": "Star color", "default": "#ff9f1a" },
    { "type": "color", "id": "card_bg", "label": "Card background", "default": "#ffffff" },
    { "type": "color", "id": "background", "label": "Background", "default": "#f6f4ef" },
    { "type": "color", "id": "text_color", "label": "Text color", "default": "#1d1b24" },
    { "type": "range", "id": "padding", "label": "Vertical padding", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 64 }
  ],
  "blocks": [
    {
      "type": "testimonial",
      "name": "Testimonial",
      "settings": [
        { "type": "textarea", "id": "quote", "label": "Quote", "default": "Exactly as pictured and arrived in two days. Already ordered a second one!" },
        { "type": "text", "id": "name", "label": "Name", "default": "Sofia M." },
        { "type": "text", "id": "detail", "label": "Detail", "default": "Verified buyer" },
        { "type": "range", "id": "rating", "label": "Rating", "min": 1, "max": 5, "step": 1, "default": 5 },
        { "type": "image_picker", "id": "avatar", "label": "Photo" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Testimonial wall",
      "blocks": [
        { "type": "testimonial" },
        { "type": "testimonial", "settings": { "quote": "The quality is unreal for the price. Customer service answered my question within an hour.", "name": "Daniel K." } },
        { "type": "testimonial", "settings": { "quote": "Gift for my sister — she loved it.", "name": "Priya S.", "rating": 4 } },
        { "type": "testimonial", "settings": { "quote": "I've tried five brands and this is the one I keep coming back to. Packaging was beautiful too, zero plastic.", "name": "Marta R." } },
        { "type": "testimonial", "settings": { "quote": "Fast shipping to Portugal and easy returns. 10/10.", "name": "João P." } },
        { "type": "testimonial", "settings": { "quote": "Fits perfectly. Sizing guide was spot on.", "name": "Emma L." } }
      ]
    }
  ]
}
{% endschema %}
